        "        choice = int(input(\"اختيارك: \"))\n",
        "\n",
        "        if choice == 0:\n",
        "            print(\"تم إلغاء التعديل.\")\n",
        "            return\n",
        "\n",
        "        if choice < 1 or choice > len(fields):\n",
        "            print(\"اختيار غير صحيح.\")\n",
        "            return\n",
        "\n",
        "        field = fields[choice - 1]\n",
