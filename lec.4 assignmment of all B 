        "import csv\n",
        "import os\n",
        "\n",
        "\n",
        "\n",
        "def load_records(filename):\n",
        "    if not os.path.exists(filename):\n",
        "        return []\n",
        "\n",
        "    with open(filename, \"r\", encoding=\"utf-8-sig\", newline=\"\") as file:\n",
        "        reader = csv.DictReader(file)\n",
        "        return list(reader)\n",
        "\n",
        "\n",
        "\n",
        "def save_records(records, filename):\n",
        "    if not records:\n",
        "        print(\"لا توجد سجلات لحفظها.\")\n",
        "        return\n",
        "\n",
        "    os.makedirs(os.path.dirname(filename) or \".\", exist_ok=True)\n",
        "\n",
        "    with open(filename, \"w\", encoding=\"utf-8-sig\", newline=\"\") as file:\n",
        "        writer = csv.DictWriter(\n",
        "            file,\n",
        "            fieldnames=list(records[0].keys())\n",
        "        )\n",
        "        writer.writeheader()\n",
        "        writer.writerows(records)\n",
        "\n",
        "\n",
        "\n",
        "def find_record(records, record_id):\n",
        "    for record in records:\n",
        "        if str(record.get(\"id\", \"\")) == str(record_id):\n",
        "            return record\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "\n",
        "def filter_records(records, category):\n",
        "    result = []\n",
        "\n",
        "    for record in records:\n",
        "        record_category = str(record.get(\"category\", \"\"))\n",
        "\n",
        "        if category.lower() in record_category.lower():\n",
        "            result.append(record)\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "\n",
        "def summarize(records):\n",
        "    if not records:\n",
        "        return \"لا توجد سجلات لتلخيصها.\"\n",
        "\n",
        "    total = len(records)\n",
        "\n",
        "    categories = {}\n",
        "\n",
        "    for record in records:\n",
        "        category = record.get(\"category\", \"غير محدد\")\n",
        "\n",
        "        categories[category] = categories.get(category, 0) + 1\n",
        "\n",
        "    result = f\"إجمالي عدد السجلات: {total}\\n\"\n",
        "    result += \"عدد السجلات حسب التصنيف:\\n\"\n",
        "\n",
        "    for category, count in categories.items():\n",
        "        result += f\"- {category}: {count}\\n\"\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "\n",
        "def display_records(records):\n",
        "    if not records:\n",
        "        print(\"لا توجد سجلات.\")\n",
        "        return\n",
        "\n",
        "    for record in records:\n",
        "        print(record)\n",
        "\n",
        "\n",
        "\n",
        "def search_by_name(records, name):\n",
        "    results = []\n",
        "\n",
        "    for record in records:\n",
        "        record_name = str(record.get(\"name\", \"\"))\n",
        "\n",
        "        if name.lower() in record_name.lower():\n",
        "            results.append(record)\n",
        "\n",
        "    return results\n",
        "\n",
        "\n",
        "\n",
        "def edit_record(records, record_id):\n",
        "    record = find_record(records, record_id)\n",
        "\n",
        "    if record is None:\n",
        "        print(\"لم يتم العثور على السجل.\")\n",
        "        return\n",
        "\n",
        "    print(\"\\nبيانات السجل الحالية:\")\n",
        "    print(record)\n",
        "\n",
        "    print(\"\\nاختر الحقل الذي تريد تعديله:\")\n",
        "\n",
        "    fields = list(record.keys())\n",
        "\n",
        "    for index, field in enumerate(fields, start=1):\n",
